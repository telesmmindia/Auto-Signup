TELEGRAM_BOT_TOKEN=your-khelofun-signup-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

# Optional: CapSolver API key (https://capsolver.com). Not needed here --
# khelofun is the same Laravel template as cricmatch247 and doesn't
# WAF-CAPTCHA its register endpoint either (unlike spin24star).
CAPSOLVER_API_KEY=

# signup | gameplay | stockmarket | password | all -- which command set this
# instance exposes. This instance runs khelofun SIGNUPS only; the
# stockmarket hedge commands live on their own bot (see
# .env.khelofun.stockmarket.example).
BOT_MODE=signup
BOT_SITE_URL=https://khelofun.com
ADMINS_FILE=admins.khelofun.signup.json
SETTINGS_FILE=bot_settings.khelofun.signup.json
ADMIN_PHONES_FILE=admin_phones.khelofun.signup.json
