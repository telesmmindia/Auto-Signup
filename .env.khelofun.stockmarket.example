# Khelofun STOCK MARKET bot: same feature as .env.stockmarket.example, just
# pointed at khelofun.com instead of cricmatch247. The paired-hedge commands
# (/pair, /pairs, /delpair, /run, /stoprun, /runs, /runlog) drive Evolution's
# "Stock Market Live" -- acc1 bets UP, acc2 bets DOWN on the same round, and
# BOTH positions are cashed out together each round. No signup commands, and
# no /testbaccarat (Baccarat-specific, stays on a Baccarat gameplay bot).
#
# NOT YET LIVE-VERIFIED for khelofun specifically: login/casino selectors are
# copied from cricmatch (see sites/khelofun.py -- confirmed via matching
# template/markup, not a real login test), and the STOCKMARKET GameProfile's
# door-in tile ("Baccarat"/"Baccarat A" in the site's OWN lobby, then
# Evolution's in-game lobby search for "Stock Market") assumes khelofun's
# casino catalogue matches cricmatch's. Verify with `/testbaccarat` first
# (confirms login + casino nav + Baccarat A opens), then `/run <pair> 10 1`
# (khelofun's Stock Market table minimum, same as cricmatch's) before
# scaling up.
TELEGRAM_BOT_TOKEN=your-khelofun-stockmarket-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

BOT_MODE=stockmarket
BOT_SITE_URL=https://khelofun.com
ADMINS_FILE=admins.khelofun.stockmarket.json
SETTINGS_FILE=bot_settings.khelofun.stockmarket.json
# Pair credentials + run history. MUST be distinct from every other
# instance's files -- each process reads them once at import and rewrites
# them whole on every save, so two bots sharing a path silently clobber
# each other. (pairs.* holds plaintext passwords; both patterns are
# gitignored.)
PAIRS_FILE=pairs.khelofun.stockmarket.json
PAIR_RUNS_FILE=pair_runs.khelofun.stockmarket.json

# How many /run hedge sessions may execute at once (each drives two Chromium
# browsers). Default 3.
# MAX_CONCURRENT_RUNS=3

# NOTE on sizing: Stock Market Live's table minimum is 10 rupees -- start
# with "/run <pair> 10 1" before scaling either the amount or the rounds,
# same as the cricmatch instance.
