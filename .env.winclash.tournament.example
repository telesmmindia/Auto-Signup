# WinClash -- MULTI-ID WAGER (knockout tournament) tab.
#
#   cp .env.winclash.tournament.example .env.winclash.tournament
#   .venv/bin/python tournament_runner.py --env .env.winclash.tournament --dry-run
#   .venv/bin/python tournament_runner.py --env .env.winclash.tournament
#   .venv/bin/python tournament_runner.py --env .env.winclash.tournament --watch
#
# Same script, same sheet layout and the same bracket rules as the cricmatch /
# khelofun / starexch tournaments: many accounts play Baccarat in groups until
# ONE account holds the whole pot. Sheet columns:
#   A USERNAME | B PASSWORD | C START BALANCE | D BALANCE | E STAGE OUT | F RESULT
# You fill A and B; the runner writes C-F. Control cell I1: type START to
# launch a run in --watch mode (no confirmation step -- it bets for real the
# moment the cell reads START, so restrict who can edit the sheet).
#
# WHAT IS DIFFERENT ABOUT WINCLASH, so nobody re-derives it:
#   * Tables are opened by URL, not by clicking a lobby tile
#     (/casinoRedirect?q=86&provider=evolution). _open_table_for owns that, so
#     the tournament needs no flag for it -- but it does mean a table must be
#     in sites/winclash.py's casino_game_ids by its REAL id (read from the
#     site's own /casinoGamesList with probe_winclash_games.py, never guessed).
#     ==> Do NOT set TOURNAMENT_LOBBY_TILE here unless that tile name is in
#     casino_game_ids: on this site the name is looked up in that table, not
#     searched for in Evolution's in-game lobby.
#   * Every page load AND the login call itself can be met by an AWS WAF wall,
#     so CAPSOLVER_API_KEY is REQUIRED (unlike cricmatch/khelofun). Solved
#     tokens are cached per site+exit IP for a few minutes and shared between
#     seats in the same process, so a group of 6 does not pay 6 solves.
#   * There is no HTTP login here (the WAF only answers a real browser), so
#     `--check` cannot run and tournament.diagnose_account answers "unknown"
#     rather than pretending it checked. Seating failures therefore fall back
#     to the ordinary browser retry ladder. Check accounts with
#     verify_baccarat.py instead.
#   * The exit IP is the whole story on winclash. The shared 51.194.232.95
#     that every other bot on the server uses is BURNT (405 +
#     x-amzn-waf-action: captcha on POST /api2/v2/login, even with a solved
#     token); .114 logs in first try. Give this run its own IPs.
BOT_SITE_URL=https://winclash.com/

# REQUIRED on this site. Without it a seat fails at the wall with a clear
# message rather than hanging -- but every seat fails, so the run does nothing.
CAPSOLVER_API_KEY=your-capsolver-api-key

# --- roster sheet ---------------------------------------------------------
TOURNAMENT_SPREADSHEET_ID=your-spreadsheet-id-from-the-sheet-url
# The gid of the MULTI-ID WAGER tab (the number after #gid= in the sheet URL).
TOURNAMENT_WORKSHEET_GID=0
TOURNAMENT_CREDENTIALS_FILE=service_account.json

# --- capacity -------------------------------------------------------------
# One live-video Chromium per seat. Kept smaller than cricmatch's 10 because
# each winclash seat also carries a WAF clear (and possibly a CapSolver solve)
# on top of the login, so a big group takes longer to seat -- and a seat's
# grip on the table decays with age (see CLAUDE.md's seat-decay measurements).
TOURNAMENT_GROUP_SIZE=6
# Groups playing at the same time. Start at 1 on this site until a full run
# has been watched end to end; the machine runs GROUP_SIZE x this many
# browsers at once.
TOURNAMENT_PARALLEL_GROUPS=1
# Hard cap on browsers open AT ONCE across all lanes; the runner clamps lanes
# to fit under it, loudly. 30 at once went blind for 94 minutes on starexch.
TOURNAMENT_MAX_SEATS=12

# --- rate limiting --------------------------------------------------------
# Seconds between one seat's login and the next, queued PER EXIT IP. winclash
# blocks the login CALL behaviourally per IP, so this is the knob that keeps a
# group under the wall -- wider than the 5s used on the Laravel sites.
TOURNAMENT_LOGIN_SPACING=15
# Spreading seats over several residential IPs is the only real fix; more
# lanes without more IPs makes the WAF worse, not the run faster. Comma or
# space separated, any format parse_proxy() accepts. MUST NOT be the shared
# 51.194.232.95 (burnt for winclash logins).
TOURNAMENT_PROXIES=
# Fallback when TOURNAMENT_PROXIES is empty: the single proxy the winclash
# gameplay bot has configured, re-read live so /setproxy there applies here.
SETTINGS_FILE=bot_settings.winclash.gameplay.json

# --- table ----------------------------------------------------------------
# Baccarat A, game id 86 -- DRIVEN LIVE 2026-08-31 (verify_baccarat.py from
# the VPS): it opens table_id nx7ecktjzywdqwwt, the SAME physical table
# cricmatch's Baccarat A reaches, with a real chip rail of
# 100/500/2500/10000/50000/100000. So the minimum is 100 a side, and an
# eliminated account keeps up to 99.
TOURNAMENT_TABLE_MIN=100
TOURNAMENT_TABLE_MAX=200000
# A cleanup pass over the leftovers (as .env.starexch.cleanup does) would be
# TOURNAMENT_GAME=roulette + TOURNAMENT_TABLE_MIN=10 in a SECOND env file.
# winclash's Auto-Roulette is id 220 in casino_game_ids, but nothing has ever
# opened it here. verify_baccarat.py --tile "Auto-Roulette" will still open it
# and report the real table id, chip rail and betting windows (its bet-spot
# check is baccarat's, so red/black show as absent -- that part is expected).

# Its OWN state file -- two tournament instances sharing one silently erase
# each other's record of who held what.
TOURNAMENT_STATE_FILE=tournament_state.winclash.json
TOURNAMENT_CONTROL_CELL=I1
TOURNAMENT_CONTROL_LABEL_CELL=H1
TOURNAMENT_POLL_SECONDS=20
