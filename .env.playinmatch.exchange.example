# exchange.py -- playinmatch99 multi-ID exchange bet bot.
#
# ⚠️ playinmatch99 is NOT the khelstake24/starexch555 platform. It runs the
# "jeetwin" exchange white-label: different routes, a different betslip
# field list, a different odds provider, and no series level at all (its
# matches are listed flat). That half lives in exchange_sites.py, which
# picks the adapter from EXCHANGE_SITE_URL's hostname -- so this is still
# just an env file, but changing the URL to some other site would NOT
# silently work the way it does between khelstake and starexch.
#
# Copy to .env.playinmatch.exchange (gitignored) and fill in. Run:
#   .venv/bin/python exchange.py --env .env.playinmatch.exchange
#
# This is a SEPARATE PROCESS from the other exchange instances: its own bot
# token and its own ADMINS_FILE. Two processes must never share an admins
# file -- it is read at import and rewritten wholesale, so they clobber.

# Telegram bot token from @BotFather -- a NEW bot, not another instance's.
EXCHANGE_BOT_TOKEN=123456:ABC-your-token-here

# Comma/space-separated Telegram user IDs that may run the bot. Not
# changeable from inside the bot, only here (+ restart).
MASTER_ADMIN_ID=6936428138

# The site. The hostname is what selects the jeetwin adapter.
EXCHANGE_SITE_URL=https://playinmatch99.com
# Shown in /start; defaults to the hostname if unset.
EXCHANGE_SITE_NAME=playinmatch99

# ── Accounts sheet ──
# Row 1 = header, row 2+ = USERNAME | PASSWORD. The bot writes each ID's
# balance into column C, so GIVE IT ITS OWN TAB -- a tab another script
# already writes (balance_checker.py's, say) would have the two processes
# overwrite each other's column C.
EXCHANGE_SHEET_ID=put-the-spreadsheet-id-here
EXCHANGE_WORKSHEET_NAME=PLAYINMATCH IDS
# Or the gid straight out of the sheet URL (…/edit?gid=1162463240).
# Set, it wins over the name and survives the tab being renamed.
# EXCHANGE_WORKSHEET_GID=
# Service account JSON (gitignored); share the sheet with its client_email
# as Editor -- the bot writes balances back.
SHEET_CREDENTIALS_FILE=service_account.json

# One proxy per line, host:port or host:port:user:pass (gitignored list).
# Accounts are handed proxies round-robin at login.
EXCHANGE_PROXY_FILE=proxies.txt

# Parallel bet placements per confirm. Keep at or below the proxy count.
EXCHANGE_BET_CONCURRENCY=5

# ── Site rules ──
# 0 = no client-side minimum, let the server decide -- it names its own
# figure when it refuses a stake. playinmatch's own betslip JS shows a
# "The Minimun stake is 2000.00" panel, the same number khelstake's does,
# and on khelstake smaller stakes turned out to be accepted in practice
# (operator, 2026-10-22). Set a number here only to stop a fat-finger
# stake before it is sent.
EXCHANGE_MIN_STAKE=0
EXCHANGE_MIN_ODDS=1.01
EXCHANGE_MAX_ODDS=5.0

# Live odds provider. playinmatch reads its own from
# odds.funoddsin.com (NOT khelstake's odds4.starlingpay.co.uk); left
# unset, the adapter uses that default, so this normally stays commented.
# EXCHANGE_ODDS_HOST=https://odds.funoddsin.com

# Persisted admin list written by /addadmin and /removeadmin. MUST differ
# from every other instance's (matches the admins.*.json gitignore rule).
ADMINS_FILE=admins.exchange.playinmatch.json
