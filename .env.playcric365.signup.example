# playcric365 SIGNUP bot. Same commands and same engine as the cricmatch /
# khelofun signup bots -- playcric365.com runs the same white-label Laravel
# template, and its register modal (fetched from /append/loginpp) carries
# cricmatch's ids byte for byte. See sites/playcric365.py for exactly what
# was confirmed on 2026-10-22 and what was not.
#
# No CapSolver key is needed: this site has no WAF. A bare request to "/"
# answers 200 with a normal Laravel session, unlike winclash/spin24star.
TELEGRAM_BOT_TOKEN=your-playcric365-signup-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

CAPSOLVER_API_KEY=

# signup | gameplay | stockmarket | password | all -- which command set this
# instance exposes. This one runs SIGNUPS only; the Stock Market hedge
# commands live on their own bot (.env.playcric365.stockmarket.example).
BOT_MODE=signup
# Add the affiliate code when there is one: https://playcric365.com?btag=<code>
# (or set it at runtime with /btag <code>).
BOT_SITE_URL=https://playcric365.com

# MUST be distinct from every other instance's files -- each process reads
# them once at import and rewrites them whole on every save, so two bots
# sharing a path silently clobber each other. accounts.db IS shared on
# purpose (its url/referral_code columns already separate the sites).
ADMINS_FILE=admins.playcric365.signup.json
SETTINGS_FILE=bot_settings.playcric365.signup.json
ADMIN_PHONES_FILE=admin_phones.playcric365.signup.json

# /fast (HTTP-only signup) is OFF for this site in code
# (supports_http_fast=False in sites/playcric365.py): POST /register exists
# and is very probably the same JSON endpoint cricmatch's fast path drives,
# but it was never run here, and --fast fails SILENTLY when a field name is
# wrong. Turning /fast on in chat is harmless -- begin_signup() says the
# site doesn't support it and falls back to the browser.
