# playcric365.com -- Mines wagering bot (BOT_MODE=mines)
#
# The same bot as .env.funcrash.mines: one account stakes a bet on Spribe's
# Mines, reveals NOTHING, and lets the game's own idle "Auto cashout in: N"
# countdown settle the round at 1.00x. The stake comes back; the product is
# turnover, not profit.
#
#   cp .env.playcric365.mines.example .env.playcric365.mines
#   .venv/bin/python telegram_bot.py --env .env.playcric365.mines
#
# What is DIFFERENT from funcrash, all read live 2026-11-02 and all expressed
# as profile data rather than code (sites/playcric365.py):
#   * Mines is game id 984 on provider spribe, and it launches from
#     /playNow?q=984&provider=spribe&type=slots -- NOT /casinoRedirect.
#   * No WAF at all, so no CAPSOLVER_API_KEY is needed here. A seat takes
#     ~13s rather than funcrash's ~30s because there is no wall to clear.
#   * The profile sets a real Chrome user agent, and that is load-bearing:
#     Spribe's config CDN flat-403s headless Chromium's UA, and the client
#     then dies with "Retry limit of client config exceeded!".
# The client at the end of the route is identical to funcrash's, so the
# engine, the commands and the stop rules are all unchanged.
#
# Verified live on this site: login, launch, the wallet (read off the outer
# aviaport document), the mines-count dropdown and three stake values, each
# confirmed by read-back. NOT yet verified here: a round in flight. funcrash
# has since run 100 clean rounds, but that was a different operator, so do
# one small run first and read /runlog:
#   /run <acc> 10 1

TELEGRAM_BOT_TOKEN=
MASTER_ADMIN_ID=

BOT_MODE=mines
BOT_SITE_URL=https://playcric365.com/

# Deliberately absent: playcric365 has no WAF (a bare curl of "/" answers 200),
# so no CapSolver credit is spent here.

# Two processes must never share these -- they are read at import and
# rewritten wholesale, so they would clobber each other. In particular these
# must differ from .env.playcric365.signup/.gameplay/.stockmarket, which
# already run against this same site.
ADMINS_FILE=admins.playcric365.mines.json
SETTINGS_FILE=bot_settings.playcric365.mines.json
MINES_ACCOUNTS_FILE=mines_accounts.playcric365.json
MINES_RUNS_FILE=mines_runs.playcric365.json

# How many accounts may wager at once. Each is its own Chromium holding a live
# game, so this tracks what the machine can hold -- and how many distinct exit
# IPs are available, since this family of sites rate-limits logins per IP
# (~20 in a few minutes trips a ~20 minute block). Watch /runlog for login
# failures before raising it; the fix for volume is more proxy IPs, not a
# bigger number.
MAX_CONCURRENT_RUNS=5

# PROXY is set at runtime with /setproxy.
