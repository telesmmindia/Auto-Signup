# khelstake24 -- password changes driven by a Google Sheet, same as the
# cricmatch / starexch / khelofun ones. (This used to be a Telegram /cp bot;
# replaced 2026-11-04.)
# Run: .venv/bin/python password_changer.py --env .env.khelstake.password
#
# Sheet columns: USERNAME | CURRENT PASSWORD | NEW PASSWORD | STATUS
# A row with A+B filled and an empty STATUS is processed once. A blank NEW
# PASSWORD is generated and written into column C before the attempt, so the
# sheet always holds the real new password. Clear STATUS by hand to retry.
BOT_SITE_URL=https://khelstake24.com
# Only read for its "proxy" key -- it is the settings file the old /cp bot
# kept its /setproxy in, so the proxy carries over. Edit it by hand now.
SETTINGS_FILE=bot_settings.password.khelstake.json

# The khelstake workbook (the one the exchange bot reads its accounts from).
PASSWORD_SHEET_SPREADSHEET_ID=your-spreadsheet-id-from-the-sheet-url
# The "KHELSTAKE PASS CHANGE" tab. NEVER gid 0 in this workbook -- that is
# the exchange bot's "Acc creds" tab, BALANCE in column C, which this script
# would read as new passwords.
PASSWORD_SHEET_WORKSHEET_GID=1126053474
PASSWORD_SHEET_CREDENTIALS_FILE=service_account.json

# khelstake accepts /changePassword from a bare requests.Session (confirmed
# live 2026-11-03 on the refusal path), so each row is a ~2s HTTP login, not
# a browser. Pacing matches the other password sheets.
PASSWORD_SHEET_MAX_CONCURRENT=1
PASSWORD_SHEET_CHECK_SPACING_SECONDS=30
PASSWORD_SHEET_POLL_SECONDS=20
