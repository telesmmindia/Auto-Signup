# khelstake24 PASSWORD-CHANGE bot: only /cp (master-only) plus proxy and
# admin management. Same exclusive mode as the cricmatch one (.env.password),
# pointed at khelstake24.
# Run: .venv/bin/python telegram_bot.py --env .env.khelstake.password
#
# khelstake accepts /changePassword from a bare requests.Session (confirmed
# live 2026-11-03), so /cp takes the ~2s no-browser route.
TELEGRAM_BOT_TOKEN=your-password-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

BOT_MODE=password
BOT_SITE_URL=https://khelstake24.com
# Distinct from every other instance -- two processes must not share these.
ADMINS_FILE=admins.password.khelstake.json
SETTINGS_FILE=bot_settings.password.khelstake.json
