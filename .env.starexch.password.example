# starexch555 -- PASSWORD CHANGE tab of the shared starexch workbook.
# Run: .venv/bin/python password_changer.py --env .env.starexch.password
# Sheet columns: USERNAME | PASSWORD | NEW PASSWORD | STATUS
# A blank NEW PASSWORD is generated and written into column C before the
# attempt, so the sheet always holds the real new password.
BOT_SITE_URL=https://starexch555.com
SETTINGS_FILE=bot_settings.starexch.json

PASSWORD_SHEET_SPREADSHEET_ID=your-spreadsheet-id-from-the-sheet-url
# TODO: replace with the real gid of the password-change tab -- read it off
# that tab's URL (the "#gid=" number). 0 is the balance tab; leaving this at
# 0 would make the password changer read the WRONG tab.
PASSWORD_SHEET_WORKSHEET_GID=REPLACE_ME
PASSWORD_SHEET_CREDENTIALS_FILE=service_account.json

# starexch accepts /changePassword from a bare requests.Session (confirmed
# live 2026-08-19, ~2s), so rows take the HTTP route rather than a ~30s
# Playwright login. Pacing stays conservative until this is proven at volume.
PASSWORD_SHEET_MAX_CONCURRENT=1
PASSWORD_SHEET_CHECK_SPACING_SECONDS=30
PASSWORD_SHEET_POLL_SECONDS=20
