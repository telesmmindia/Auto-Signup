# starexch555 -- CLEANUP run: drain every account's sub-100 leftover into the
# winner, on Auto-Roulette (min/chip Rs 10, red vs black).
#
# Run this AFTER the main baccarat tournament, against the SAME sheet: the
# main run cannot touch balances under Rs 100 (baccarat's smallest chip), so
# each eliminated id keeps up to Rs 99. This second knockout funnels those
# remainders into one account and leaves at most Rs 9 per id.
#
# Why roulette is safe HERE and banned for the main run: a zero (2.7% of
# spins) takes both sides' stakes. On Rs 10-90 cleanup stakes that expected
# cost is pennies; on a full pot it would be a catastrophe risk.
#
# Run: .venv/bin/python tournament_runner.py --env .env.starexch.cleanup
BOT_SITE_URL=https://starexch555.com
SETTINGS_FILE=bot_settings.starexch.json

TOURNAMENT_SPREADSHEET_ID=your-spreadsheet-id
TOURNAMENT_WORKSHEET_GID=0
TOURNAMENT_CREDENTIALS_FILE=service_account.json

TOURNAMENT_GAME=roulette
TOURNAMENT_TABLE_MIN=10
TOURNAMENT_TABLE_MAX=200000

TOURNAMENT_GROUP_SIZE=6
TOURNAMENT_PARALLEL_GROUPS=2
TOURNAMENT_MAX_SEATS=12
TOURNAMENT_LOGIN_SPACING=5
#TOURNAMENT_PROXIES=host:port:user:pass host2:port2:user2:pass2

# Its OWN state file -- never share one between instances.
TOURNAMENT_STATE_FILE=tournament_state.starexch.cleanup.json
TOURNAMENT_CONTROL_CELL=I1
TOURNAMENT_CONTROL_LABEL_CELL=H1
