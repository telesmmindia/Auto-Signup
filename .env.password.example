# Cricmatch PASSWORD-CHANGE bot: only /changepassword (master-only) plus
# proxy and admin management. No signup, casino, or hedge commands here --
# this is a deliberately separate, exclusive mode (like stockmarket) so a
# plain single-bot `.env` setup never accidentally exposes a command that
# mutates a real account's login credential.
TELEGRAM_BOT_TOKEN=your-password-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

BOT_MODE=password
BOT_SITE_URL=https://cricmatch247.com?btag=211079
ADMINS_FILE=admins.password.json
SETTINGS_FILE=bot_settings.password.json
