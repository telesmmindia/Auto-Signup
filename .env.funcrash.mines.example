# funcrash.com -- Mines wagering bot (BOT_MODE=mines)
#
# One account at a time stakes a bet on Spribe's Mines, reveals NOTHING, and
# lets the game's own idle "Auto cashout in: N" countdown settle the round at
# 1.00x. The stake comes back; the product is turnover, not profit.
#
#   cp .env.funcrash.mines.example .env.funcrash.mines
#   .venv/bin/python telegram_bot.py --env .env.funcrash.mines
#
# BEFORE THE FIRST REAL RUN, confirm the round actually behaves that way on
# this account -- it is the one thing that has not been watched live:
#   .venv/bin/python probe_mines.py <user> <pass> --url https://funcrash.com/ \
#       --game-id 3139 --provider spribe --mines 1 --watch-round
# Run it at the client's default stake (10.00), which is the most the check
# can cost if the auto-cashout does not return the money.

TELEGRAM_BOT_TOKEN=
MASTER_ADMIN_ID=

BOT_MODE=mines
BOT_SITE_URL=https://funcrash.com/

# REQUIRED on funcrash: its AWS WAF walls ordinary page loads, and the game
# tab can be walled on its own even after a clean entry. Without a key a run
# fails at the wall with a clear message instead of hanging.
CAPSOLVER_API_KEY=

# Two processes must never share these -- they are read at import and
# rewritten wholesale, so they would clobber each other.
ADMINS_FILE=admins.funcrash.mines.json
SETTINGS_FILE=bot_settings.funcrash.mines.json
MINES_ACCOUNTS_FILE=mines_accounts.funcrash.json
MINES_RUNS_FILE=mines_runs.funcrash.json

# How many accounts may wager at once. Each is its own Chromium holding a live
# game, so this tracks what the machine can hold -- and, as everywhere else
# here, how many distinct exit IPs are available, since funcrash throttles
# logins per IP.
MAX_CONCURRENT_RUNS=2

# funcrash blocks logins per exit IP, so give this instance its own.
# PROXY is set at runtime with /setproxy.
