# FunCrash SIGNUP bot. Same commands and same engine as the winclash signup
# bot (.env.winclash.example) -- funcrash.com is the same "rjm"/jeet
# white-label, and its /join-now form and signup JavaScript are
# byte-identical to winclash's (compared live 2026-11-07; see
# sites/funcrash.py for exactly what was checked and what was not).
#
# NOT verified yet: a real signup with a real SMS. Do one /newacc on a real
# number, then log into the new account, before running volume.
TELEGRAM_BOT_TOKEN=your-funcrash-signup-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

# REQUIRED on funcrash, same as winclash. Every page load can be met by an
# AWS WAF "Human Verification" wall. The soft "challenge" clears itself for
# free; the hard "captcha" (served on the very first dry run 2026-11-07)
# needs a solved token. Solved tokens are cached for ~10 minutes per exit
# IP, so a run of signups pays roughly one solve per few minutes, not one
# per signup.
CAPSOLVER_API_KEY=your-capsolver-api-key

BOT_MODE=signup
# Put the affiliate code in the link (or set it later in chat with
# /btag <code>). The code is credited through a COOKIE that funcrash sets on
# /?btag=<code> -> /setcookie, not through the register form -- the engine
# enters the site that way and checks the cookie landed before every signup.
BOT_SITE_URL=https://funcrash.com/

# MUST be distinct from every other instance's files -- each process reads
# them once at import and rewrites them whole on every save, so two bots
# sharing a path silently clobber each other. In particular NOT the
# funcrash gameplay/mines bots' files. accounts.db IS shared on purpose
# (its url/referral_code columns already separate the sites).
ADMINS_FILE=admins.funcrash.signup.json
SETTINGS_FILE=bot_settings.funcrash.signup.json
ADMIN_PHONES_FILE=admin_phones.funcrash.signup.json

# /fast on (HTTP-only signup, no browser) is SUPPORTED here, using
# winclash's call sequence. The first two steps were exercised against
# funcrash; the OTP steps need a real SMS and have not been watched yet, so
# leave /fast off until one browser signup has gone through cleanly.
#
# There is no free-number endpoint on this platform, so /freenumber does
# nothing here -- use a /setphone pool of several numbers instead.
