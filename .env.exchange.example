# exchange.py -- khelstake24 multi-ID exchange bet bot.
# Copy to .env.exchange and fill in (gitignored; this example is the
# documented template). Run: .venv/bin/python exchange.py --env .env.exchange

# Telegram bot token from @BotFather (the bot's OWN token -- exchange.py is
# standalone, not a BOT_MODE of telegram_bot.py).
EXCHANGE_BOT_TOKEN=123456:ABC-your-token-here

# Comma/space-separated Telegram user IDs that may run the bot. Cannot be
# changed from inside the bot, only here (+ restart).
MASTER_ADMIN_ID=6936428138

# Google Sheet holding the account IDs: row 1 = header, row 2+ =
# USERNAME | PASSWORD. Share the sheet with the service account as Editor.
EXCHANGE_SHEET_ID=
# Optional: worksheet/tab name (defaults to the first sheet).
EXCHANGE_WORKSHEET_NAME=
# Service account JSON (gitignored).
SHEET_CREDENTIALS_FILE=service_account.json

# Site + proxies.
EXCHANGE_SITE_URL=https://khelstake24.com
# One proxy per line, host:port or host:port:user:pass. GITIGNORED -- these
# hold credentials and this repo is public. Accounts are handed proxies
# round-robin at login, one fixed proxy per account.
#
# ⚠️ THIS INSTANCE STAYS ON THE ROTATING GATEWAY, and the reason is the size
# of its roster. Measured on the real sheet 2026-11-04, same code, same
# accounts, minutes apart -- the proxy file was the only variable:
#
#     instance (roster)      5 residential IPs    rotating gateway
#     khelstake24 (321)      56 OK / 265 failed   187 OK / 134 failed
#     starexch555  (80)      45 OK /  35 failed    72 OK /   8 failed
#
# The failures are Laravel's "Too Many Attempts" -- the per-IP login block.
# Five FIXED IPs means a 321-account sweep puts ~64 logins on each, far past
# the ~20-in-a-few-minutes threshold, while the gateway hands out a fresh
# exit per CONNECTION (verified: 5 connections, 5 distinct IPs), so each
# login is effectively its own IP.
#
# Both of these sites answer 200 from the VPS's own datacenter IP AND through
# the gateway, so neither has a WAF reason to want residential -- unlike
# playinmatch and khelosports77, which are walled from a datacenter IP and
# must use proxies.residential.txt. Pick per instance: residential when the
# site walls datacenter IPs, the gateway when the roster is large.
EXCHANGE_PROXY_FILE=proxies.txt

# Parallel bet placements per confirm (client decision: 5).
EXCHANGE_BET_CONCURRENCY=5

# Site minimum stake (server enforces 2000 too -- see exchange.py docstring).
EXCHANGE_MIN_STAKE=2000

# Persisted admin list, written by /addadmin and /removeadmin
# (matches the admins.*.json gitignore pattern).
ADMINS_FILE=admins.exchange.json
