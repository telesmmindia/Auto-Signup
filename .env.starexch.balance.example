# starexch555 -- BALANCE tab of the shared starexch workbook.
# Run: .venv/bin/python balance_checker.py --env .env.starexch.balance
# Sheet columns: USERNAME | PASSWORD | BALANCE | STATUS
BOT_SITE_URL=https://starexch555.com
SETTINGS_FILE=bot_settings.starexch.json

BALANCE_SHEET_SPREADSHEET_ID=your-spreadsheet-id-from-the-sheet-url
# gid=0 is the first tab, taken from the URL you sent.
BALANCE_SHEET_WORKSHEET_GID=0
BALANCE_SHEET_CREDENTIALS_FILE=service_account.json

# starexch answers the login + getBalance API on a bare requests.Session
# (confirmed live 2026-08-19, 1.8s per account), so every row takes the
# HTTP-fast route -- no browser. The pacing defaults below still apply:
# cricmatch's /login volume block is a per-site edge rule and starexch has
# not been tested at volume, so start conservative and only loosen this
# while watching for "blocked" rows.
BALANCE_MAX_CONCURRENT=1
BALANCE_CHECK_SPACING_SECONDS=30
BALANCE_BLOCK_BACKOFF_SECONDS=300
BALANCE_POLL_SECONDS=20
