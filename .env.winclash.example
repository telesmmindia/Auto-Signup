TELEGRAM_BOT_TOKEN=your-winclash-signup-bot-token-from-botfather
# One id, or several comma-/space-separated ids for multiple master admins:
# MASTER_ADMIN_ID=111111111,222222222
MASTER_ADMIN_ID=your-telegram-user-id

# REQUIRED for this site, unlike cricmatch/khelofun. winclash sits behind an
# AWS WAF that serves a "Human Verification" page in front of ordinary
# navigation -- both the homepage (HTTP 202, x-amzn-waf-action: challenge)
# and the signup page (HTTP 405, x-amzn-waf-action: captcha). The soft
# "challenge" clears itself once the page's own challenge.js runs, and the
# engine waits that out for free. The hard "captcha" never clears on its own
# and needs this key (see ensure_waf_cleared() in main.py). Without it a
# signup fails with a clear message rather than hanging.
CAPSOLVER_API_KEY=your-capsolver-api-key

# signup | gameplay | stockmarket | password | all -- which command set this
# instance exposes. This instance runs winclash SIGNUPS only.
BOT_MODE=signup
BOT_SITE_URL=https://winclash.com/

# Must be DISTINCT from every other instance's files -- these are read at
# import and rewritten wholesale, so two bots sharing one would clobber each
# other. accounts.db is shared on purpose.
ADMINS_FILE=admins.winclash.json
SETTINGS_FILE=bot_settings.winclash.json
ADMIN_PHONES_FILE=admin_phones.winclash.json
