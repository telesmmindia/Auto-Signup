# exchange.py -- starexch555 multi-ID exchange bet bot.
#
# Same script, same protocol as the khelstake24 instance: starexch555 runs
# the identical exchange white-label (verified live 2026-10-21 -- routes,
# parsers, odds provider, limit blob and stake/odds rules all matched
# unchanged), so this is an env file, not a fork.
#
# Copy to .env.starexch.exchange (gitignored) and fill in. Run:
#   .venv/bin/python exchange.py --env .env.starexch.exchange
#
# This is a SEPARATE PROCESS from the khelstake instance: its own bot token
# and its own ADMINS_FILE. Two processes must never share an admins file --
# it is read at import and rewritten wholesale, so they would clobber.

# Telegram bot token from @BotFather -- a NEW bot, not the khelstake one.
EXCHANGE_BOT_TOKEN=123456:ABC-your-token-here

# Comma/space-separated Telegram user IDs that may run the bot. Not
# changeable from inside the bot, only here (+ restart).
MASTER_ADMIN_ID=6936428138

# The site.
EXCHANGE_SITE_URL=https://starexch555.com
# Shown in /start; defaults to the hostname if unset.
EXCHANGE_SITE_NAME=starexch555

# ── Accounts sheet ──
# Row 1 = header, row 2+ = USERNAME | PASSWORD. The bot writes each ID's
# balance into column C, so GIVE IT ITS OWN TAB: the starexch workbook's
# "BAL UPDATE" tab is already written by balance_checker.py and the two
# would overwrite each other's column C. Make a tab (e.g. "EXCHANGE IDS")
# with USERNAME | PASSWORD | BALANCE and name it below.
EXCHANGE_SHEET_ID=1Emm8m2bIhtttFpxLXsWdOAGtpvrLliY8KgWKRSOVi7E
EXCHANGE_WORKSHEET_NAME=EXCHANGE IDS
# Service account JSON (gitignored); share the sheet with its client_email
# as Editor -- the bot writes balances back.
SHEET_CREDENTIALS_FILE=service_account.json

# One proxy per line, host:port or host:port:user:pass (gitignored list).
# Accounts are handed proxies round-robin at login.
EXCHANGE_PROXY_FILE=proxies.txt

# Parallel bet placements per confirm. Keep at or below the proxy count:
# starexch's edge rate-blocks /login on volume from one IP (see CLAUDE.md
# section 1, "Login rate blocking") and that block is per exit IP.
EXCHANGE_BET_CONCURRENCY=5

# ── Site rules ──
# All three read out of starexch555's own inline JS 2026-10-21 and matching
# khelstake's: min stake 2000 (the SERVER enforces it too), Match Odds
# priced 1.01-5.0. Only change these if the site's JS changes.
EXCHANGE_MIN_STAKE=2000
EXCHANGE_MIN_ODDS=1.01
EXCHANGE_MAX_ODDS=5.0

# Live odds provider. starexch uses the same host as khelstake (read off
# its own page), so this normally stays as the default.
# EXCHANGE_ODDS_HOST=https://odds4.starlingpay.co.uk

# Persisted admin list written by /addadmin and /removeadmin. MUST differ
# from the khelstake instance's (matches the admins.*.json gitignore rule).
ADMINS_FILE=admins.exchange.starexch.json
