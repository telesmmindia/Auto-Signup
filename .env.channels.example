# channel_info.py -- fills a Google Sheet with Telegram channel details.
# cp .env.channels.example .env.channels, then fill these in.

# From https://my.telegram.org -> API development tools. These are NOT a bot
# token: a real user account is required, since bots can't resolve arbitrary
# public usernames or read private invite links.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Where the login session is saved. The first run asks for your phone number,
# the code Telegram sends, and your 2FA password if you have one; after that
# it starts silently. Gitignored (*.session).
CHANNEL_SESSION=channel_info

# The sheet's id -- the long code in its URL, between /d/ and /edit.
CHANNEL_SHEET_SPREADSHEET_ID=
# The tab, if it isn't the first one (the gid=... in the URL).
CHANNEL_SHEET_WORKSHEET_GID=0
# Reuses the same service account as the other sheet scripts by default.
# CHANNEL_SHEET_CREDENTIALS_FILE=service_account.json

# How often to look for newly added rows.
CHANNEL_POLL_SECONDS=20
# Gap between two channel lookups. Telegram rate-limits this per ACCOUNT and
# the penalty is a flood-wait of minutes to hours -- raise this rather than
# lower it if you ever see flood-waits.
CHANNEL_SPACING_SECONDS=3
# Longest description written into the sheet, in characters.
CHANNEL_DESCRIPTION_LIMIT=1000
