# telegram_bot.py -- starexch555 SIGNUP bot, for the starexch365.com?btag=230853
# client link. starexch365.com is only a redirect: every path 301s to the same
# path on starexch555.com, and the btag reaches starexch555's own /setcookie
# route, so the bot points straight at starexch555 (a POST to starexch365
# would be turned into a GET by the 301).
#
# Copy to .env.starexch.signup (gitignored), fill in, then:
#   .venv/bin/python telegram_bot.py --env .env.starexch.signup
# and in chat (master): /seturl https://starexch555.com?btag=230853  /fast on

TELEGRAM_BOT_TOKEN=your-starexch-signup-bot-token-from-botfather
MASTER_ADMIN_ID=your-telegram-user-id

# Not needed: starexch's register endpoint is cricmatch's, no WAF captcha.
CAPSOLVER_API_KEY=

BOT_MODE=signup
BOT_SITE_URL=https://starexch555.com?btag=230853
ADMINS_FILE=admins.starexch.signup.json
SETTINGS_FILE=bot_settings.starexch.signup.json
ADMIN_PHONES_FILE=admin_phones.starexch.signup.json
