# Knockout tournament runner (tournament_runner.py).
#
#   cp .env.tournament.example .env.tournament
#   .venv/bin/python tournament_runner.py --env .env.tournament --dry-run
#   .venv/bin/python tournament_runner.py --env .env.tournament
#
# Not a Telegram bot -- there is no BOT_TOKEN here. This is a standalone
# script like balance_checker.py / sheet_watcher.py.

# Which site the accounts live on. Baccarat needs the casino selectors, so
# cricmatch247 only for now (sites/cricmatch.py is the one with
# supports_casino=True).
BOT_SITE_URL=https://cricmatch247.com

# --- roster sheet ---------------------------------------------------------
# Columns: A USERNAME | B PASSWORD | C BALANCE | D STAGE OUT | E RESULT
# You fill A and B; the script writes C, D and E as accounts are knocked out.
# Share the sheet with the service account's client_email, Editor access.
TOURNAMENT_SPREADSHEET_ID=
TOURNAMENT_WORKSHEET_GID=0
# Falls back to SHEET_CREDENTIALS_FILE, then service_account.json -- reuse the
# same service account as the balance/hedge sheets, just share this one too.
TOURNAMENT_CREDENTIALS_FILE=service_account.json

# --- capacity -------------------------------------------------------------
# One Chromium per seat, each streaming live casino video. This is a machine
# limit, not a tuning knob -- 10 is comfortable on a 16GB Mac.
TOURNAMENT_GROUP_SIZE=10

# How many GROUPS play at the same time. Every pair inside one group already
# bets on the same hand, so this is the only serial part left: groups used to
# be played one after another, which is where a 100-account run spent 6-7
# hours. The machine ends up running GROUP_SIZE x this many browsers at once,
# so raise it only as far as this box has RAM for -- start at 2. Logins stay
# paced globally, so lanes do NOT multiply the login rate.
TOURNAMENT_PARALLEL_GROUPS=1

# --- rate limiting --------------------------------------------------------
# Seconds between starting one seat's login and the next. The site hard-blocks
# (bare 403, clears after ~20min) at roughly 20 logins in a few minutes from
# one IP -- see CLAUDE.md's balance_checker findings. Ten seats opening at once
# from one IP is exactly that pattern, so they are staggered.
# Now that the pacer queues PER EXIT IP, this is per proxy, not global -- with
# five proxies, 5 here means one login per IP every 25s, safer than the old
# global 20s and it seats ten browsers in 50s instead of 200s. Seating fast
# matters on its own: a seat's grip on the table decays with age (see
# CLAUDE.md), so a group that takes 200s to seat starts half dead.
TOURNAMENT_LOGIN_SPACING=5

# Spreading seats over several IPs is the only real fix for the above. Comma
# or space separated, same formats parse_proxy() accepts. If left empty the
# script falls back to the single proxy in SETTINGS_FILE below, re-read live so
# /setproxy on that bot instance applies here with no edit needed.
TOURNAMENT_PROXIES=
SETTINGS_FILE=bot_settings.gameplay.json

# --- table limits ---------------------------------------------------------
# Read live off Baccarat A's BET LIMITS panel: five ranges, the two main
# (100-minimum) spots capping at 500000 and 200000. Which row is Player/Banker
# was NOT established, so the conservative one is the default. Betting over the
# real cap is silently rejected by the table, which lands one side of a pair
# unhedged -- raise this only after reading the expanded panel yourself.
TOURNAMENT_TABLE_MIN=100
TOURNAMENT_TABLE_MAX=200000

# Full per-hand record, rewritten after every group so a crash still leaves a
# trail of who held what.
TOURNAMENT_STATE_FILE=tournament_state.json

# --- sheet-triggered mode (--watch) ---------------------------------------
# Runs as a service and starts tournaments from the sheet, no terminal needed.
# Type START in the control cell and it plays. The same cell reports back:
# IDLE -> RUNNING (stage n) -> DONE ... winner=x
#
# There is NO confirmation step -- START begins real betting across the whole
# roster straight away. Restrict who can edit this sheet accordingly.
TOURNAMENT_CONTROL_CELL=I1
TOURNAMENT_CONTROL_LABEL_CELL=H1
TOURNAMENT_POLL_SECONDS=20
